<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ArrowBuddies.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FFF7EC</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.ArrowBuddies</item>
    </style>

    <style name="Theme.ArrowBuddies" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#FFF7EC</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>

