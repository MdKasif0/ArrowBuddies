    <!-- 24 Fun Facts -->
    <string name="fact_bunny">Rabbits can jump over 3 feet high in a single leap!</string>
    <string name="fact_chick">Baby chicks communicate with their mothers before hatching!</string>
    <string name="fact_piglet">Pigs have an amazing sense of smell and love puzzles!</string>
    <string name="fact_puppy">Every dog has a unique nose print, just like a fingerprint!</string>
    <string name="fact_lamb">Sheep have rectangular pupils that give them 300° vision!</string>
    <string name="fact_calf">Cows have best friends and get happier when together!</string>
    <string name="fact_monkey">Monkeys use their tails for balance and can swing like acrobats!</string>
    <string name="fact_tiger_cub">Every tiger has a completely unique stripe pattern on its fur!</string>
    <string name="fact_parrot">Parrots are among the smartest birds and love rhythmic music!</string>
    <string name="fact_penguin">Penguins wear natural tuxedos to camouflage while swimming!</string>
    <string name="fact_polar_cub">Polar bear fur is actually clear and hollow, reflecting light as white!</string>
    <string name="fact_arctic_fox">Arctic foxes change their fur color to pure white in winter!</string>
    <string name="fact_turtle">Sea turtles can hold their breath underwater for several hours!</string>
    <string name="fact_otter">Sea otters hold hands while sleeping so they don\'t drift away!</string>
    <string name="fact_crab">Crabs communicate with each other by drumming their claws on sand!</string>
    <string name="fact_owl">Owls can rotate their heads up to 270 degrees to look around!</string>
    <string name="fact_hedgehog">Hedgehogs roll into a spike ball when startled to stay safe!</string>
    <string name="fact_raccoon">Raccoons have super-sensitive front paws that feel extra clear in water!</string>
    <string name="fact_camel">Camels can close their nostrils during desert windstorms!</string>
    <string name="fact_fennec_fox">Fennec foxes have giant ears that radiate heat away in the desert!</string>
    <string name="fact_meerkat">Meerkats have dark fur patches around their eyes that act like sunglasses!</string>
    <string name="fact_red_panda">Red pandas use their big bushy ringed tails as blankets in winter!</string>
    <string name="fact_elephant_calf">Elephant calves suck their trunks for comfort, just like human babies!</string>
    <string name="fact_peacock">Only male peacocks have iridescent green-and-gold fan feathers!</string>

